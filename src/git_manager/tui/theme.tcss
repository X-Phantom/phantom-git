/* Phantom Git v0.5.0 — Pure Lazygit Single-Screen Purple & Neon Theme */

Screen {
    background: #0B0716;
    color: #F3E8FF;
    layout: vertical;
}

#workspace-grid {
    height: 1fr;
    layout: horizontal;
    padding: 0 1;
}

#left-dock {
    width: 35%;
    min-width: 36;
    height: 1fr;
    padding-right: 1;
}

#right-main {
    width: 65%;
    height: 1fr;
}

.lazygit-panel {
    background: #0B0716;
    border: round #7B2CBF;
    border-title-color: #F3E8FF;
    border-title-style: bold;
    border-title-align: left;
    border-subtitle-color: #F3E8FF;
    border-subtitle-align: right;
    padding: 0 1;
    margin-bottom: 0;
}

.lazygit-panel:focus-within {
    border: round #00FF87;
    border-title-color: #00FF87;
    border-subtitle-color: #00FF87;
    background: #130B24;
}

/* Left Column Panel Heights */
#panel-status {
    height: 3;
}

#panel-files {
    height: 2fr;
}

#panel-branches {
    height: 1fr;
}

#panel-commits {
    height: 1fr;
}

#panel-safety {
    height: 1fr;
    min-height: 4;
}

/* Right Column 3 Larger Containers */
#panel-github-repos {
    height: 2fr;
}

#panel-ci-flow {
    height: 2fr;
}

#panel-command-log {
    height: 1fr;
    min-height: 6;
}

#status-summary {
    color: #F3E8FF;
    height: 1;
}

#github-account-bar {
    color: #E0AAFF;
    height: 1;
    margin-bottom: 0;
}

#ci-flow-summary {
    color: #F3E8FF;
    height: auto;
    max-height: 3;
    border-bottom: solid #5A189A;
    padding-bottom: 0;
    margin-bottom: 0;
}

/* Inner lists and logs sit flush inside outer Lazygit panel borders */
.lazygit-panel OptionList,
.lazygit-panel RichLog {
    background: transparent;
    color: #F3E8FF;
    border: none;
    height: 1fr;
    padding: 0;
    scrollbar-color: #9D4EDD;
    scrollbar-color-hover: #E040FB;
}

.lazygit-panel OptionList:focus,
.lazygit-panel RichLog:focus {
    border: none;
}

OptionList > .option-list--option-highlighted {
    background: #3C096C;
    color: #00F5D4;
    text-style: bold;
}

/* Bottom Lazygit Keybindings Footer Bar */
#lazygit-footer {
    height: 1;
    background: #0B0716;
    color: #00F5D4;
    padding: 0 1;
    layout: horizontal;
}

#footer-keybindings {
    width: 1fr;
    color: #00F5D4;
}

#footer-version {
    width: auto;
    color: #E040FB;
    text-align: right;
    text-style: bold;
}

/* Modal Dialogs & Inputs */
Button {
    background: #2D124D;
    color: #F3E8FF;
    border: tall #9D4EDD;
    height: 3;
    min-width: 10;
    margin-right: 1;
}

Button:hover {
    background: #7B2CBF;
    color: #00F5D4;
    border: tall #E040FB;
}

Button.-primary {
    background: #7B2CBF;
    color: #FFFFFF;
    border: tall #E040FB;
}

Button.-success {
    background: #083D2B;
    color: #00FF87;
    border: tall #00FF87;
}

Button.-warning {
    background: #4A3500;
    color: #FFD60A;
    border: tall #FFD60A;
}

Button.-error {
    background: #4D0022;
    color: #FF0055;
    border: tall #FF0055;
}

Input, Select {
    background: #1B0F33;
    color: #F3E8FF;
    border: round #7B2CBF;
}

Input:focus, Select:focus {
    border: heavy #E040FB;
}

Checkbox {
    background: transparent;
    color: #E0AAFF;
}

.field-label {
    color: #C77DFF;
    text-style: bold;
}

ModalScreen {
    align: center middle;
    background: rgba(11, 7, 22, 0.85);
}

.modal-container {
    background: #160C2B;
    border: heavy #E040FB;
    padding: 1 2;
    width: 80;
    max-width: 95%;
    height: auto;
}

.modal-title {
    color: #00F5D4;
    text-style: bold;
    margin-bottom: 1;
}

.modal-buttons {
    height: auto;
    margin-top: 1;
    align: right middle;
}

#keybindings-text {
    color: #F3E8FF;
    margin-bottom: 1;
}
